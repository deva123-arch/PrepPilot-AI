# GEMINI_API_KEY: Required for Gemini AI API calls on the backend.
# The server communicates with Google Gen AI models exclusively server-side.
# In Google AI Studio, this is injected automatically from user secrets.
# For local development, obtain a free API key from Google AI Studio (https://aistudio.google.com/).
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# In cloud hosting (Google Cloud Run), this is injected with the service URL.
APP_URL="http://localhost:3000"

# PORT: Server listen port (defaults to 3000).
# Required: 3000 in AI Studio / Cloud Run container environment.
PORT="3000"

# NODE_ENV: Server mode ('development' or 'production').
NODE_ENV="development"

# DISABLE_HMR: Set to 'true' in containerized dev environments to disable Vite file watching.
DISABLE_HMR="false"

# DATABASE & AUTHENTICATION CONFIGURATION (PRODUCTION RECOMMENDED)
# By default, PrepPilot AI uses built-in server-side encrypted file storage with scrypt
# password hashing and timing-safe session validation in .data/ (Zero external cost).
# For cloud deployments requiring an external relational database:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/preppilot"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-anon-public-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
